# Copy this file to .env and fill in values for your own environment.
# Never commit real secrets, private keys, tokens, or production IDs.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Service Account used by the Node/Express backend
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# Google Sheets / Drive / Docs IDs
SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_DRIVE_FOLDER_ID=replace-with-pr-pdf-folder-id
GOOGLE_DRIVE_PO_FOLDER_ID=replace-with-po-pdf-folder-id
TEMPLATE_PR_ID=replace-with-google-docs-pr-template-id
TEMPLATE_PO_ID=replace-with-google-docs-po-template-id

# WhatsApp gateway token (Fonnte). Optional; notifications are skipped if empty.
WA_API_TOKEN=

# Application session signing secret. Use a random value >= 32 chars.
# Example generation: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
SESSION_TTL_SECONDS=28800

# Optional Firebase OAuth config for Google Drive/Sheets user-token mode
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Telegram Bot configurations (Optional; skipped if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
